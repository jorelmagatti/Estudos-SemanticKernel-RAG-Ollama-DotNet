    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EssayWriterBlazor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Semantic Kernel -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.21.1" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.InMemory" Version="1.74.0-preview" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.74.0-alpha" />

    <!-- Tavily SDK oficial -->
    <PackageReference Include="Tavily" Version="1.0.0" />

    <!-- Blazor Server já vem no SDK Web -->
  </ItemGroup>

</Project>
